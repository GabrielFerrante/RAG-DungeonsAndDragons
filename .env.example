# Copie para .env (ignorado pelo git) e preencha. Nada aqui deve ser versionado com valores reais.
# `python main.py setup` cria este arquivo sozinho (a partir deste exemplo) e preenche DEVICE_MODE.

# Token do Hugging Face (so se algum modelo passar a exigir login)
HF_TOKEN=

# cuda | cpu | vazio (vazio = detecta sozinho a cada execucao, comparando a VRAM da GPU com
# hardware.min_vram_gb em config.yaml). So afeta a inferencia (python main.py ask).
DEVICE_MODE=
